# Copy to ~/.dbt/profiles.yml (outside the repo) and set the env vars from .env.example.
# profiles.yml itself is git-ignored.
dbt_proj_1:
  target: dev
  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DBT_DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH') }}"
      catalog: "{{ env_var('DBT_DATABRICKS_CATALOG', 'dbt_project1_dev') }}"
      schema: default
      threads: 1
      # OAuth (recommended) needs no token here. For a token:
      # token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
