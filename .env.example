# --- Databricks CLI + bundle ---
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
BUNDLE_VAR_notify_email=you@example.com

# --- dbt profile (only if you use profiles.yml.example) ---
DBT_DATABRICKS_HOST=<your-workspace>.cloud.databricks.com
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DBT_DATABRICKS_CATALOG=dbt_project1_dev